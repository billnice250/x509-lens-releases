# Copy to .env and fill in. .env is git-ignored; never commit credentials.
# Signing identity from: security find-identity -v -p codesigning
MAC_APP_IDENTITY="Developer ID Application: Havugukuri (VVVVVVVVVV)"

# Mac App Store package (make appstore)
MAC_APP_STORE_IDENTITY="Apple Distribution: Havugukuri (76XYDD23H5)"
MAC_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Havugukuri (VVVVVVVVVV)"
# Mac App Store provisioning profile for io.github.billnice250.X509Lens.
# If omitted, exactly one build/darwin/*.provisionprofile is used.
MAC_PROVISIONING_PROFILE="build/darwin/X509_Lens.provisionprofile"

# Notarization with an App Store Connect API key (preferred)
#APPLE_API_KEY_ID="XXXXXXXXXX"
#APPLE_API_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
#APPLE_API_KEY_PATH="$HOME/.private_keys/AuthKey_XXXXXXXXXX.p8"

# Or notarize with an Apple ID and an app-specific password from appleid.apple.com
APPLE_ID="you@example.com"
APPLE_TEAM_ID="76XYDD23H5"
APPLE_APP_PASSWORD="abcd-abcd-abcd-abcd"

# Alternative: store credentials with
#   xcrun notarytool store-credentials "x509lens-notary" \
#     --apple-id "you@example.com" --team-id "76XYDD23H5" --password "app-specific-password"
# then set this (the APPLE_* values above are ignored):
#NOTARY_PROFILE="x509lens-notary"
